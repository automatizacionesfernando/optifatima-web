---
// ============================================================
// PÁGINA · /audifonos-alcobendas
// ============================================================
// Sub-página piloto. Patrón replicable para las otras 6
// especialidades long-tail. La estructura se mantiene; solo
// cambian los datos importados de especialidades.js.
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactoBlock from '../components/ContactoBlock.astro';
import { negocio } from '../data/negocio.js';
import { especialidades } from '../data/especialidades.js';

const esp = especialidades.find((e) => e.slug === 'audifonos-alcobendas');
if (!esp) throw new Error('Especialidad audifonos no encontrada');

// Schema.org específico de audiología (extiende el LocalBusiness base)
const schemaExtra = {
  '@type': ['HearingAidStore', 'LocalBusiness'],
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Adaptación de audífonos',
        description: 'Adaptación personalizada de audífonos por Técnico Superior en Audiología Protésica.',
        areaServed: 'Alcobendas',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Reparación de audífonos en 24 horas',
        description: 'Servicio técnico propio. Reparación de audífonos en 24 horas en Alcobendas.',
        areaServed: 'Alcobendas',
      },
    },
  ],
};
---

<BaseLayout
  title={esp.seo.title}
  description={esp.seo.description}
  canonical={`${negocio.urls.sitio_web}/${esp.slug}`}
  schemaExtra={schemaExtra}
>

  <!-- ====================================================
       1 · HERO
       ==================================================== -->
  <section class="esp-hero">
    <div class="container container--wide">
      <div class="esp-hero__grid">
        <div class="esp-hero__content">
          <nav class="esp-hero__breadcrumbs" aria-label="Migas de pan">
            <a href={import.meta.env.BASE_URL}>Inicio</a>
            <span>/</span>
            <a href={`${import.meta.env.BASE_URL}#especialidades`}>Especialidades</a>
            <span>/</span>
            <span>{esp.titulo_corto}</span>
          </nav>
          <span class="eyebrow">{esp.hero.eyebrow}</span>
          <h1>{esp.hero.h1}</h1>
          <p class="esp-hero__lead">{esp.hero.subtitulo}</p>
          <div class="esp-hero__cta">
            <a href="#contacto" class="btn btn--primary">Pedir cita</a>
            <a href={`tel:${negocio.telefono_internacional}`} class="btn btn--ghost">
              {negocio.telefono}
            </a>
          </div>
        </div>
        <div class="esp-hero__image">
          <!-- TODO: foto profesional de audiómetro / cabina audiometría / audífono -->
          <img
            src={`${import.meta.env.BASE_URL}images/audifonos-placeholder.jpg`}
            alt="Centro auditivo de Optifatima en Alcobendas"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
       2 · QUIÉN TE ATIENDE (autoridad técnica)
       ==================================================== -->
  <section class="section section--crema-claro">
    <div class="container container--narrow">
      <div class="autoridad">
        <span class="eyebrow">Quién te atiende</span>
        <h2>Un profesional, no un mostrador rotativo</h2>
        <p>
          La diferencia entre un buen audífono y uno que acaba en un cajón es
          quién lo adapta, lo programa y lo sigue durante el primer año.
          En Optifatima esa persona es siempre la misma: <strong>{negocio.profesional.nombre}</strong>.
        </p>
        <ul class="autoridad__credenciales">
          {esp.credenciales_relevantes.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ====================================================
       3 · QUÉ HACEMOS
       ==================================================== -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Servicios</span>
        <h2>Qué hacemos en <em>audiología</em></h2>
      </div>
      <div class="que-hacemos-grid">
        {esp.que_hacemos.map((item, i) => (
          <article class="que-hacemos-card">
            <span class="que-hacemos-card__num">0{i + 1}</span>
            <h3>{item.titulo}</h3>
            <p>{item.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================
       4 · POR QUÉ IMPORTA (diferenciador destacado)
       ==================================================== -->
  <section class="section section--verde">
    <div class="container container--narrow">
      <div class="por-que-importa">
        <span class="eyebrow">Diferencial</span>
        <h2>{esp.por_que_importa.titulo}</h2>
        <p class="por-que-importa__texto">
          {esp.por_que_importa.texto}
        </p>
      </div>
    </div>
  </section>

  <!-- ====================================================
       5 · FAQ específica
       ==================================================== -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Lo que la gente nos pregunta</h2>
      </div>
      <div class="faq-list">
        {esp.faq.map((item) => (
          <details class="faq-item">
            <summary>{item.pregunta}</summary>
            <p>{item.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================
       6 · CONTACTO + MAPA
       ==================================================== -->
  <ContactoBlock
    id="contacto"
    titulo="Tu centro auditivo en Alcobendas"
  />

</BaseLayout>

<style>
  /* ---- HERO de sub-página ---- */
  .esp-hero {
    padding: var(--space-8) 0 var(--space-12);
  }
  .esp-hero__breadcrumbs {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-verde-medio);
    margin-bottom: var(--space-5);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .esp-hero__breadcrumbs a:hover { color: var(--color-terracota); }

  .esp-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .esp-hero__grid { grid-template-columns: 1fr 1fr; gap: var(--space-10); }
  }
  .esp-hero__lead {
    font-size: var(--text-lg);
    color: var(--color-verde-medio);
    margin: var(--space-5) 0 var(--space-6);
    max-width: 52ch;
  }
  .esp-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .esp-hero__image img {
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
  }

  /* ---- AUTORIDAD ---- */
  .autoridad h2 {
    margin: var(--space-3) 0 var(--space-5);
  }
  .autoridad p {
    font-size: var(--text-lg);
    color: var(--color-verde-medio);
    margin-bottom: var(--space-5);
  }
  .autoridad__credenciales {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .autoridad__credenciales li {
    background: var(--color-blanco);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--color-verde-prof);
    border: 1px solid var(--color-crema-oscuro);
  }

  /* ---- QUÉ HACEMOS ---- */
  .que-hacemos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
  }
  .que-hacemos-card {
    padding: var(--space-6);
    background: var(--color-crema-claro);
    border-radius: var(--radius-lg);
    position: relative;
  }
  .que-hacemos-card__num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-terracota);
    display: block;
    margin-bottom: var(--space-3);
  }
  .que-hacemos-card h3 {
    margin-bottom: var(--space-3);
  }
  .que-hacemos-card p {
    color: var(--color-verde-medio);
    font-size: var(--text-base);
  }

  /* ---- POR QUÉ IMPORTA ---- */
  .por-que-importa {
    text-align: center;
    padding: var(--space-6) 0;
  }
  .por-que-importa h2 {
    margin-bottom: var(--space-6);
  }
  .por-que-importa__texto {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--color-crema);
    font-weight: 300;
    margin: 0 auto;
    max-width: 56ch;
  }

  /* ---- SECTION HEADERS (reutilizable) ---- */
  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-10);
  }
  .section-header h2 { margin-bottom: var(--space-4); }
  .section-header p {
    font-size: var(--text-lg);
    color: var(--color-verde-medio);
  }
</style>
