---
import { negocio } from '../data/negocio.js';
import { especialidades } from '../data/especialidades.js';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="site-footer__grid">

      <!-- Bloque marca -->
      <div class="site-footer__brand">
       <a href="/" class="site-footer__logo">
          <Logo variant="footer" size={28} />
          <span>Opti<em>fatima</em></span>
        </a>
        <p>
          Óptica y audiología familiar en Alcobendas desde {negocio.año_fundacion}.
          Te atiende siempre la misma persona, de principio a fin.
        </p>
      </div>

      <!-- Especialidades -->
      <div>
        <h5>Especialidades</h5>
        <ul>
          {especialidades.map((e) => (
            <li><a href={`/${e.slug}`}>{e.titulo_corto}</a></li>
          ))}
        </ul>
      </div>

      <!-- Sitio -->
      <div>
        <h5>Optifatima</h5>
        <ul>
          <li><a href="/#bruno">Quién te atiende</a></li>
          <li><a href="/#servicios">Servicios</a></li>
          <li><a href="/#marcas">Marcas</a></li>
          <li><a href="/#contacto">Contacto</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h5>Contacto</h5>
        <ul>
          <li><a href={`tel:${negocio.telefono_internacional}`}>{negocio.telefono}</a></li>
          <li><a href={`https://wa.me/${negocio.whatsapp.replace('+','')}`}>WhatsApp</a></li>
          <li><a href={`mailto:${negocio.email}`}>{negocio.email}</a></li>
          <li>{negocio.direccion.formato_corto}</li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {negocio.nombre} · {negocio.tagline}</p>
      <ul class="site-footer__legal">
        <li><a href="/aviso-legal">Aviso legal</a></li>
        <li><a href="/privacidad">Privacidad</a></li>
        <li><a href="/cookies">Cookies</a></li>
      </ul>
    </div>
  </div>

  <!-- WhatsApp flotante -->
  <a
    href={`https://wa.me/${negocio.whatsapp.replace('+','')}?text=Hola,%20me%20gustaría%20pedir%20cita`}
    class="whatsapp-float"
    aria-label="Contactar por WhatsApp"
    target="_blank"
    rel="noopener"
  >
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>
</footer>

<style>
  .site-footer {
    background: var(--color-verde-prof);
    color: var(--color-crema);
    padding: var(--space-12) 0 var(--space-6);
    position: relative;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }
  .site-footer__brand p {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-crema-oscuro);
    opacity: 0.85;
    max-width: 32ch;
  }
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-crema);
  }
  .site-footer__logo em {
    color: var(--color-terracota);
    font-style: italic;
  }
  .site-footer h5 {
    color: var(--color-crema);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .site-footer ul { list-style: none; }
  .site-footer ul li {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-crema-oscuro);
    opacity: 0.85;
  }
  .site-footer ul li a:hover { color: var(--color-terracota); opacity: 1; }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(245, 239, 230, 0.15);
    font-size: var(--text-xs);
    color: var(--color-crema-oscuro);
    opacity: 0.7;
  }
  .site-footer__legal {
    display: flex;
    gap: var(--space-4);
    list-style: none;
  }
  .site-footer__legal li { margin: 0; }

  @media (min-width: 768px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  /* WhatsApp flotante */
  .whatsapp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: #25D366;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    transition: transform var(--transition);
  }
  .whatsapp-float:hover { transform: scale(1.08); }
</style>
