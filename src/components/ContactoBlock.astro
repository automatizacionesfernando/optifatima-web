---
// ============================================================
// COMPONENTE · ContactoBlock
// ============================================================
// Bloque reutilizable en home + 7 sub-páginas. Renderiza
// dirección, teléfono, WhatsApp, email, horarios y embed
// del mapa de Google.
// ============================================================
import { negocio } from '../data/negocio.js';

interface Props {
  /** ID para anchor links (#contacto en la home, #contacto-audifonos en sub-páginas, etc.) */
  id?: string;
  /** Título personalizado de la sección */
  titulo?: string;
}

const {
  id = 'contacto',
  titulo = 'En el corazón de Alcobendas',
} = Astro.props;

// URL del mapa — solo se usa cuando el usuario pulsa el placeholder (sin cookies hasta entonces)
const mapaSrc = `https://www.google.com/maps?q=${encodeURIComponent(negocio.direccion.formato_corto)}&output=embed`;
---

<section id={id} class="section contacto-block">
  <div class="container">
    <div class="contacto-block__grid">

      <!-- Columna izquierda: datos -->
      <div class="contacto-block__info">
        <span class="eyebrow">Visítanos</span>
        <h2>
          {titulo.split('Alcobendas')[0]}<em>Alcobendas</em>{titulo.split('Alcobendas')[1] || ''}
        </h2>

        <div class="contacto-block__detalles">
          <div>
            <h4>Dirección</h4>
            <p class="contacto-dir">
              {negocio.direccion.calle}, {negocio.direccion.cp} {negocio.direccion.ciudad}, {negocio.direccion.provincia}
            </p>
          </div>

          <div>
            <h4>Teléfono</h4>
            <p>
              <a href={`tel:${negocio.telefono_internacional}`}>{negocio.telefono}</a>
            </p>
          </div>

          <div>
            <h4>WhatsApp</h4>
            <p>
              <a
                href={`https://wa.me/${negocio.whatsapp.replace('+','')}?text=Hola,%20me%20gustaría%20pedir%20cita`}
                target="_blank"
                rel="noopener"
              >
                {negocio.whatsapp_display}
              </a>
            </p>
          </div>

          <div>
            <h4>Email</h4>
            <p><a href={`mailto:${negocio.email}`}>{negocio.email}</a></p>
          </div>

          <div class="contacto-block__horarios">
            <h4>Horarios</h4>
            <p>
              Lunes a Viernes · {negocio.horarios.lunes_viernes}<br/>
              Sábados · {negocio.horarios.sabados}<br/>
              Domingos · {negocio.horarios.domingos}<br/>
              Festivos · {negocio.horarios.festivos}
            </p>
          </div>
        </div>

        <div class="contacto-block__cta">
          <a href={`tel:${negocio.telefono_internacional}`} class="btn btn--primary">
            Llamar ahora
          </a>
          <a
            href={`https://wa.me/${negocio.whatsapp.replace('+','')}?text=Hola,%20me%20gustaría%20pedir%20cita`}
            class="btn btn--ghost"
            target="_blank"
            rel="noopener"
          >
            Escribir por WhatsApp
          </a>
        </div>
      </div>

      <!-- Columna derecha: mapa (carga al clic — no se cargan cookies de Google hasta que el usuario lo abre) -->
      <div class="contacto-block__mapa">
        <button
          type="button"
          class="mapa-placeholder"
          data-mapa-src={mapaSrc}
          aria-label="Ver el mapa de la ubicación de Optifatima en Google Maps"
        >
          <svg class="mapa-placeholder__pin" viewBox="0 0 24 24" width="44" height="44" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/>
          </svg>
          <span class="mapa-placeholder__titulo">Ver mapa</span>
          <span class="mapa-placeholder__dir">{negocio.direccion.formato_corto}</span>
          <span class="mapa-placeholder__nota">Al pulsar se carga Google Maps, que puede usar sus propias cookies.</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .contacto-block {
    background: var(--color-crema-claro);
  }
  .contacto-block__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }
  @media (min-width: 900px) {
    .contacto-block__grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-10);
    }
  }

  .contacto-block__info h2 {
    margin-bottom: var(--space-6);
  }

  .contacto-block__detalles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .contacto-block__horarios {
    grid-column: 1 / -1;
  }

  .contacto-block__detalles h4 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracota);
    margin-bottom: var(--space-2);
  }
  .contacto-block__detalles p {
    font-size: var(--text-base);
    color: var(--color-verde-medio);
    margin: 0;
  }
  .contacto-block__detalles a:hover {
    color: var(--color-terracota);
  }

  .contacto-block__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contacto-dir {
    white-space: normal;
    word-break: keep-all;
    overflow-wrap: anywhere;
    font-size: clamp(0.9rem, 3.2vw, 1rem);
  }

  @media (max-width: 540px) {
    .contacto-block__detalles { grid-template-columns: 1fr; }
  }

  /* Mapa "al clic" — placeholder que no carga cookies hasta que el usuario pulsa */
  .mapa-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    height: 500px;
    border-radius: var(--radius-lg);
    background: var(--color-crema);
    border: 1px solid var(--color-border);
    cursor: pointer;
    text-align: center;
    padding: var(--space-6);
    font-family: var(--font-body);
    color: var(--color-text-body);
    transition: background var(--transition);
  }
  .mapa-placeholder:hover,
  .mapa-placeholder:focus-visible {
    background: var(--color-crema-claro);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .mapa-placeholder__pin { color: var(--color-accent); }
  .mapa-placeholder__titulo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-heading);
  }
  .mapa-placeholder__dir {
    font-size: var(--text-base);
    color: var(--color-verde-medio);
  }
  .mapa-placeholder__nota {
    font-size: var(--text-xs);
    color: var(--color-verde-medio);
    opacity: 0.75;
    max-width: 34ch;
  }
</style>

<script>
  function activarMapa(boton) {
    const src = boton.getAttribute('data-mapa-src');
    if (!src) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.width = '100%';
    iframe.height = '500';
    iframe.loading = 'lazy';
    iframe.style.border = '0';
    iframe.style.borderRadius = 'var(--radius-lg)';
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
    iframe.title = 'Ubicación de Optifatima en Alcobendas';
    boton.replaceWith(iframe);
  }
  document.querySelectorAll('.mapa-placeholder').forEach((boton) => {
    boton.addEventListener('click', () => activarMapa(boton));
  });
</script>
